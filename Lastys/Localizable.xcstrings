        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ នឹងត្រូវបានស្នើសុំឱ្យយល់ព្រម។ អ្នកទាំងពីរនៅតែមានគូ ខណៈ %@ មាន 7 ថ្ងៃដើម្បីឆ្លើយតប។"
