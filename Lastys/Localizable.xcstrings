      }
    },
    "The QR you are showing now, and any screenshot or shared card that has it, will stop working. Share the new one instead." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "The QR you are showing now, and any screenshot or shared card that has it, will stop working. Share the new one instead." } },
        "km" : { "stringUnit" : { "state" : "needs_review", "value" : "QR ដែលអ្នកកំពុងបង្ហាញឥឡូវនេះ ព្រមទាំងរូបថតអេក្រង់ ឬកាតដែលបានចែករំលែកដែលមាន QR នេះ នឹងឈប់ដំណើរការ។ សូមចែករំលែក QR ថ្មីជំនួសវិញ។" } }
      }
    },
    "Revoking needs an internet connection. Your current QR still works." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Revoking needs an internet connection. Your current QR still works." } },
        "km" : { "stringUnit" : { "state" : "needs_review", "value" : "ការដកហូតត្រូវការអ៊ីនធឺណិត។ QR បច្ចុប្បន្នរបស់អ្នកនៅតែដំណើរការ។" } }
      }
    },
    "Couldn't reach Lastys. Your current QR still works. Try again." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Couldn't reach Lastys. Your current QR still works. Try again." } },
        "km" : { "stringUnit" : { "state" : "needs_review", "value" : "មិនអាចទាក់ទង Lastys បានទេ។ QR បច្ចុប្បន្នរបស់អ្នកនៅតែដំណើរការ។ សូមព្យាយាមម្តងទៀត។" } }
      }
    },
    "Your QR stays the same until you revoke it, and works without internet. If someone has a screenshot of it, revoke it: the old QR stops working at once." : {
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Your QR stays the same until you revoke it, and works without internet. If someone has a screenshot of it, revoke it: the old QR stops working at once." } },
        "km" : { "stringUnit" : { "state" : "needs_review", "value" : "QR របស់អ្នកនៅដដែលរហូតដល់អ្នកដកហូតវា ហើយដំណើរការដោយគ្មានអ៊ីនធឺណិត។ ប្រសិនបើនរណាម្នាក់មានរូបថតអេក្រង់របស់វា សូមដកហូត៖ QR ចាស់នឹងឈប់ដំណើរការភ្លាមៗ។" } }
      }
    },
