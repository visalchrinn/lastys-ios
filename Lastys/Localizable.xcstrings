    "%@ has until %@ to agree or decline. You're both still Taken until then." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ has until %@ to agree or decline. You're both still Taken until then."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%@ មានរហូតដល់ %@ ដើម្បីយល់ព្រម ឬបដិសេធ។ អ្នកទាំងពីរនៅតែមានគូរហូតដល់ពេលនោះ។"
          }
