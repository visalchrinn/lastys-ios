{
  "name": "A Taken Lastys ID cannot send a Relationship request",
  "steps": [
    { "phone": "alice", "do": "create-lastys-id" },
    { "phone": "alice", "do": "update-profile", "with": { "nickname": "Alice" } },
    { "phone": "bob", "do": "create-lastys-id" },
    { "phone": "bob", "do": "update-profile", "with": { "nickname": "Bob" } },
    { "phone": "carol", "do": "create-lastys-id" },
    { "phone": "carol", "do": "update-profile", "with": { "nickname": "Carol" } },
    { "phone": "alice", "do": "scan", "with": { "qrOf": "bob" } },
    { "phone": "alice", "do": "send-relationship-request" },
    { "phone": "bob", "do": "accept-relationship-request", "with": { "from": "alice" } },
    { "phone": "alice", "do": "scan", "with": { "qrOf": "carol" }, "expect": { "status": "single", "requestBlocked": "you-are-taken" } },
    { "phone": "alice", "do": "send-relationship-request", "expect": { "error": "you-are-taken" } }
  ]
}
