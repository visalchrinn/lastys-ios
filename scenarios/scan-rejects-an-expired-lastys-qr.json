{
  "name": "A Lastys QR is accepted until two whole minutes have passed since the minute it was made in, then rejected as expired",
  "steps": [
    { "phone": "alice", "do": "create-lastys-id" },
    { "phone": "alice", "do": "update-profile", "with": { "nickname": "Alice" } },
    { "phone": "bob", "do": "create-lastys-id" },
    { "phone": "bob", "do": "scan", "with": { "qrOf": "alice", "madeMinutesAgo": "2" }, "expect": { "status": "single" } },
    { "phone": "bob", "do": "scan", "with": { "qrOf": "alice", "madeMinutesAgo": "3" }, "expect": { "error": "expired-qr" } }
  ]
}
