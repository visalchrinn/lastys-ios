{
  "name": "Completing a Recovery makes any transfer code from the old phone useless",
  "steps": [
    {
      "phone": "alice",
      "do": "create-lastys-id"
    },
    {
      "phone": "alice",
      "do": "update-profile",
      "with": {
        "nickname": "Alice"
      }
    },
    {
      "phone": "bob",
      "do": "create-lastys-id"
    },
    {
      "phone": "bob",
      "do": "update-profile",
      "with": {
        "nickname": "Bob"
      }
    },
    {
      "phone": "alice-new",
      "do": "start-recovery",
      "with": {
        "codeOf": "alice",
        "which": "current"
      }
    },
    {
      "phone": "alice",
      "do": "start-phone-transfer"
    },
    {
      "phone": "alice-new",
      "do": "wait",
      "with": {
        "days": "7"
      }
    },
    {
      "phone": "alice-new",
      "do": "complete-recovery",
      "expect": {
        "personalIDOf": "alice"
      }
    },
    {
      "phone": "alice-other",
      "do": "complete-phone-transfer",
      "with": {
        "from": "alice"
      },
      "expect": {
        "error": "transfer-code-invalid"
      }
    },
    {
      "phone": "alice-new",
      "do": "get-relationship-status",
      "expect": {
        "status": "none"
      }
    }
  ]
}
