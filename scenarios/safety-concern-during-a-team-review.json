{
  "name": "A safety concern raised during a Team review of an End request makes it a safety review",
  "steps": [
    {
      "phone": "alice",
      "do": "create-lastys-id"
    },
    {
      "phone": "alice",
      "do": "update-profile",
      "with": {
        "nickname": "Alice"
      }
    },
    {
      "phone": "bob",
      "do": "create-lastys-id"
    },
    {
      "phone": "bob",
      "do": "update-profile",
      "with": {
        "nickname": "Bob"
      }
    },
    {
      "phone": "carol",
      "do": "create-lastys-id"
    },
    {
      "phone": "carol",
      "do": "update-profile",
      "with": {
        "nickname": "Carol"
      }
    },
    {
      "phone": "alice",
      "do": "scan",
      "with": {
        "qrOf": "bob"
      }
    },
    {
      "phone": "alice",
      "do": "send-relationship-request"
    },
    {
      "phone": "bob",
      "do": "accept-relationship-request",
      "with": {
        "from": "alice"
      }
    },
    {
      "phone": "alice",
      "do": "send-end-request"
    },
    {
      "phone": "bob",
      "do": "decline-end-request"
    },
    {
      "phone": "alice",
      "do": "escalate-to-team-review"
    },
    {
      "phone": "bob",
      "do": "get-relationship-status",
      "expect": {
        "stage": "team-review",
        "reviewReason": "end-request"
      }
    },
    {
      "phone": "bob",
      "do": "report-safety-concern"
    },
    {
      "phone": "alice",
      "do": "get-relationship-status",
      "expect": {
        "status": "active",
        "stage": "team-review",
        "reviewReason": "safety-concern"
      }
    },
    {
      "phone": "lastys-team",
      "do": "team-decides",
      "with": {
        "about": "bob",
        "end": "true"
      }
    },
    {
      "phone": "alice",
      "do": "get-relationship-status",
      "expect": {
        "status": "cooling-off",
        "until": "2026-12-06"
      }
    }
  ]
}
