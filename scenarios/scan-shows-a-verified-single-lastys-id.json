{
  "name": "A Scan of a live Lastys QR shows that Lastys ID's status, with Relationship history hidden by default",
  "steps": [
    { "phone": "alice", "do": "create-lastys-id" },
    { "phone": "alice", "do": "update-profile", "with": { "nickname": "Alice" } },
    { "phone": "bob", "do": "create-lastys-id" },
    {
      "phone": "bob",
      "do": "scan",
      "with": { "qrOf": "alice" },
      "expect": { "status": "single", "nickname": "Alice", "idAgeDays": "0", "phoneTransfers": "0", "history": "hidden" }
    }
  ]
}
