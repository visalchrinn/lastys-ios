{
  "name": "After 7 days with no answer, the requester can ask for a Team review, and the team can keep the Relationship",
  "steps": [
    {
      "phone": "alice",
      "do": "create-lastys-id"
    },
    {
      "phone": "alice",
      "do": "update-profile",
      "with": {
        "nickname": "Alice"
      }
    },
    {
      "phone": "bob",
      "do": "create-lastys-id"
    },
    {
      "phone": "bob",
      "do": "update-profile",
      "with": {
        "nickname": "Bob"
      }
    },
    {
      "phone": "carol",
      "do": "create-lastys-id"
    },
    {
      "phone": "carol",
      "do": "update-profile",
      "with": {
        "nickname": "Carol"
      }
    },
    {
      "phone": "alice",
      "do": "scan",
      "with": {
        "qrOf": "bob"
      }
    },
    {
      "phone": "alice",
      "do": "send-relationship-request"
    },
    {
      "phone": "bob",
      "do": "accept-relationship-request",
      "with": {
        "from": "alice"
      }
    },
    {
      "phone": "alice",
      "do": "send-end-request"
    },
    {
      "phone": "alice",
      "do": "wait",
      "with": {
        "days": "6"
      }
    },
    {
      "phone": "alice",
      "do": "escalate-to-team-review",
      "expect": {
        "error": "cannot-escalate-yet"
      }
    },
    {
      "phone": "alice",
      "do": "wait",
      "with": {
        "days": "1"
      }
    },
    {
      "phone": "alice",
      "do": "escalate-to-team-review"
    },
    {
      "phone": "alice",
      "do": "get-relationship-status",
      "expect": {
        "stage": "team-review",
        "reviewReason": "end-request"
      }
    },
    {
      "phone": "bob",
      "do": "agree-to-end-request",
      "expect": {
        "error": "not-allowed-now"
      }
    },
    {
      "phone": "lastys-team",
      "do": "team-decides",
      "with": {
        "about": "bob",
        "end": "false"
      }
    },
    {
      "phone": "alice",
      "do": "get-relationship-status",
      "expect": {
        "status": "active",
        "stage": "together",
        "partner": "Bob"
      }
    }
  ]
}
