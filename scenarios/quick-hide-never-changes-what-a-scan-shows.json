{
  "name": "Quick hide never changes what a Scan shows: a Taken Lastys ID still Scans as Taken",
  "steps": [
    {
      "phone": "alice",
      "do": "create-lastys-id"
    },
    {
      "phone": "alice",
      "do": "update-profile",
      "with": {
        "nickname": "Alice"
      }
    },
    {
      "phone": "bob",
      "do": "create-lastys-id"
    },
    {
      "phone": "bob",
      "do": "update-profile",
      "with": {
        "nickname": "Bob"
      }
    },
    {
      "phone": "carol",
      "do": "create-lastys-id"
    },
    {
      "phone": "carol",
      "do": "update-profile",
      "with": {
        "nickname": "Carol"
      }
    },
    {
      "phone": "alice",
      "do": "scan",
      "with": {
        "qrOf": "bob"
      }
    },
    {
      "phone": "alice",
      "do": "send-relationship-request"
    },
    {
      "phone": "bob",
      "do": "accept-relationship-request",
      "with": {
        "from": "alice"
      }
    },
    {
      "phone": "alice",
      "do": "turn-on-quick-hide"
    },
    {
      "phone": "carol",
      "do": "scan",
      "with": {
        "qrOf": "alice"
      },
      "expect": {
        "status": "taken",
        "requestBlocked": "they-are-taken"
      }
    },
    {
      "phone": "alice",
      "do": "send-end-request"
    },
    {
      "phone": "carol",
      "do": "scan",
      "with": {
        "qrOf": "alice"
      },
      "expect": {
        "status": "taken"
      }
    },
    {
      "phone": "bob",
      "do": "turn-on-quick-hide"
    },
    {
      "phone": "carol",
      "do": "scan",
      "with": {
        "qrOf": "bob"
      },
      "expect": {
        "status": "taken"
      }
    },
    {
      "phone": "alice",
      "do": "get-relationship-status",
      "expect": {
        "status": "active",
        "partner": "Bob",
        "stage": "ending"
      }
    }
  ]
}
