{
  "name": "A transfer code works once, for 5 minutes, and only on a phone without a Lastys ID",
  "steps": [
    {
      "phone": "alice",
      "do": "create-lastys-id"
    },
    {
      "phone": "alice",
      "do": "update-profile",
      "with": {
        "nickname": "Alice"
      }
    },
    {
      "phone": "bob",
      "do": "create-lastys-id"
    },
    {
      "phone": "bob",
      "do": "update-profile",
      "with": {
        "nickname": "Bob"
      }
    },
    {
      "phone": "alice",
      "do": "start-phone-transfer"
    },
    {
      "phone": "alice",
      "do": "wait",
      "with": {
        "minutes": "6"
      }
    },
    {
      "phone": "alice-new",
      "do": "complete-phone-transfer",
      "with": {
        "from": "alice"
      },
      "expect": {
        "error": "transfer-code-expired"
      }
    },
    {
      "phone": "alice",
      "do": "start-phone-transfer"
    },
    {
      "phone": "bob",
      "do": "complete-phone-transfer",
      "with": {
        "from": "alice"
      },
      "expect": {
        "error": "phone-already-has-lastys-id"
      }
    },
    {
      "phone": "alice-new",
      "do": "complete-phone-transfer",
      "with": {
        "from": "alice"
      }
    },
    {
      "phone": "alice-other",
      "do": "complete-phone-transfer",
      "with": {
        "from": "alice"
      },
      "expect": {
        "error": "transfer-code-invalid"
      }
    }
  ]
}
